# MongoDB Connection String (Required for auth, user profiles, and curriculum management)
# For production on AWS Amplify, configure this in:
# AWS Amplify Console -> App settings -> Environment variables
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Resend Email Service (resend.com)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="SieLabs <onboarding@resend.dev>"
